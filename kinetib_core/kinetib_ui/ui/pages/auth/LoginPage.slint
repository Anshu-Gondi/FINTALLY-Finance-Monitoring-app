import { Button, CheckBox, LineEdit } from "std-widgets.slint";

// Responsive, keyboard-friendly authentication screen shared by desktop, tablet,
// phone, and the Slint WASM shell. Storage scope is an explicit user choice.
export component LoginPage inherits Rectangle {
    background: #070b16;

    in-out property <string> email-input: "";
    in-out property <string> password-input: "";
    in-out property <string> status-text: "Sign in to continue.";
    in-out property <bool> busy: false;
    in-out property <bool> local-only-mode: true;

    callback sign-in-requested(string, string, bool);
    callback signup-navigation-requested();
    callback google-navigation-requested();

    VerticalLayout {
        padding: root.width < 480px ? 16px : 28px;
        spacing: 16px;
        alignment: center;

        Rectangle {
            width: root.width < 540px ? root.width - 32px : 460px;
            background: #101a2c;
            border-radius: 24px;
            border-width: 1px;
            border-color: #25445a;

            VerticalLayout {
                padding: root.width < 480px ? 20px : 30px;
                spacing: 14px;

                Rectangle {
                    width: 64px;
                    height: 4px;
                    background: #4be6c0;
                    border-radius: 2px;
                }
                Text {
                    text: "KINETIB  /  PRIVATE FINANCE";
                    color: #4be6c0;
                    font-size: 11px;
                    font-weight: 700;
                }
                Text {
                    text: "Your money. Your terms.";
                    color: #eef6ff;
                    font-size: 28px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: "Sign in to your workspace and keep control of where your financial data lives.";
                    color: #a5b5cd;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                LineEdit {
                    width: 100%;
                    height: 44px;
                    text <=> root.email-input;
                    placeholder-text: "Email address";
                    enabled: !root.busy;
                    accessible-label: "Email address";
                }
                LineEdit {
                    width: 100%;
                    height: 44px;
                    text <=> root.password-input;
                    placeholder-text: "Password";
                    input-type: password;
                    enabled: !root.busy;
                    accessible-label: "Password";
                }

                CheckBox {
                    width: 100%;
                    text: "Keep finance data on this device only";
                    checked <=> root.local-only-mode;
                    enabled: !root.busy;
                }
                Text {
                    text: root.local-only-mode
                        ? "LOCAL ONLY · no cloud account database is used for this sign-in."
                        : "CLOUD SYNC · explicitly selected; a cloud connection is required.";
                    color: root.local-only-mode ? #4be6c0 : #ffcf70;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Button {
                    width: 100%;
                    text: root.busy ? "Signing in…" : "Sign in";
                    primary: true;
                    enabled: !root.busy;
                    clicked => {
                        root.sign-in-requested(
                            root.email-input,
                            root.password-input,
                            root.local-only-mode
                        );
                        root.password-input = "";
                    }
                }
                Button {
                    width: 100%;
                    text: "Create an account";
                    enabled: !root.busy;
                    clicked => { root.signup-navigation-requested(); }
                }

                Text {
                    text: root.status-text;
                    color: #d7e4f7;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Passwords are sent only to the selected FinTally authentication path. This screen never accesses the database directly.";
                    color: #8295b2;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
