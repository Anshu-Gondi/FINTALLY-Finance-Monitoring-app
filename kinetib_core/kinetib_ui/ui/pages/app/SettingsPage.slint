import { Button } from "std-widgets.slint";

// Page shell only. Wire this callback to a typed IPC client method from Rust.
export component SettingsPage inherits Rectangle {
    background: #070b16;
    in-out property <string> status-text: "Ready. Connect this page to its app service.";
    in-out property <bool> busy: false;
    in-out property <bool> local-only-mode: true;
    callback save-requested();

    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        Text {
            text: "Settings and privacy";
            font-size: 28px;
            font-weight: 700;
            color: #edf5ff;
        }
        Text {
            text: "Choose local-only versus cloud sync separately from email versus Google sign-in.";
            color: #a5b5cd;
            wrap: word-wrap;
        }
                Text { text: root.local-only-mode ? "Data mode: Local-only" : "Data mode: Cloud sync"; color: #b4c3d9; }
                Button {
                    text: root.local-only-mode ? "Enable cloud sync" : "Use local-only mode";
                    clicked => { root.local-only-mode = !root.local-only-mode; }
                }
                Button { text: "Save preferences"; enabled: !root.busy; clicked => { root.save-requested(); } }
        Rectangle {
            background: #101a2c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #26364f;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text { text: "Page status"; font-size: 16px; font-weight: 600; color: #edf5ff; }
                Text { text: root.status-text; color: #b4c3d9; wrap: word-wrap; }
            }
        }
    }
}
