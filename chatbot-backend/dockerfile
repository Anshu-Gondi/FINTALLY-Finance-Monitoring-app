# syntax=docker/dockerfile:1.4
# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
# IMPORTANT: that first line enables BuildKit inline syntax.
# Build with:  DOCKER_BUILDKIT=1 docker build ...
# Or set DOCKER_BUILDKIT=1 in your shell / docker-compose env.
# ========================================================================

# ====================== BUILDER STAGE ======================
FROM ghcr.io/pyo3/maturin:latest AS builder
WORKDIR /app

# Copy Rust workspace and build all crates
COPY fintally_core/ ./fintally_core/
WORKDIR /app/fintally_core

# Each maturin call is its own cacheable layer.
# If only one crate changes, only that layer re-runs.
RUN maturin build --release -m rust_backend/Cargo.toml --strip
RUN maturin build --release -m fintally_finance/Cargo.toml --strip
RUN maturin build --release -m fintally_chatbot/Cargo.toml --strip


# ====================== LLAMA BUILD STAGE ======================
# Isolated stage so llama-cpp-python is compiled ONCE and cached
# independently of your app code or requirements changes.
FROM python:3.10-slim AS llama-builder

# Build deps for compiling llama-cpp-python from source
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# ARG so you can pass at build time:
#   docker build --build-arg LLAMA_NO_AVX=1 ...
# Default is AVX ON (for modern CPUs). Set to 1 for Celeron N4020 etc.
ARG LLAMA_NO_AVX=0

# Set CMAKE_ARGS based on the ARG — this actually works unlike your
# shell conditional trick, because ARG is real build-time state.
RUN if [ "$LLAMA_NO_AVX" = "1" ]; then \
        export CMAKE_ARGS="-DGGML_AVX=OFF -DGGML_AVX2=OFF -DGGML_AVX512=OFF -DGGML_FMA=OFF -DGGML_F16C=OFF -DGGML_NATIVE=OFF"; \
    else \
        export CMAKE_ARGS="-DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_AVX512=OFF -DGGML_FMA=ON -DGGML_F16C=ON -DGGML_NATIVE=ON"; \
    fi && \
    FORCE_CMAKE=1 pip install --no-cache-dir llama-cpp-python \
        --target /llama-install


# ====================== RUNTIME STAGE ======================
FROM python:3.10-slim
WORKDIR /app

# Runtime system libs only — no build tools, no cmake
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgl1 \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# --- Layer 1: pip deps that change rarely ---
# Copy requirements first. This layer only rebuilds if requirements.txt changes.
COPY requirements.txt ./

# Use BuildKit cache mount for pip — massively speeds up repeated builds
# on the same machine by caching the pip download cache across builds.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

# --- Layer 2: llama-cpp-python (compiled in its own stage, never recompiles) ---
# Copied from the llama-builder stage — this is just a file copy, instant.
COPY --from=llama-builder /llama-install /usr/local/lib/python3.10/site-packages/

# --- Layer 3: your Rust wheels ---
COPY --from=builder /app/fintally_core/target/wheels/*.whl /wheels/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install /wheels/*.whl

# --- Layer 4: app source (changes most often, so last) ---
COPY . .

# Security: non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]