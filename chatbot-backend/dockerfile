# ====================== BUILDER STAGE ======================
FROM ghcr.io/pyo3/maturin:latest AS builder

WORKDIR /app

# Copy Rust workspace
COPY fintally_core/ ./fintally_core/

WORKDIR /app/fintally_core

# Build all crates individually
RUN maturin build --release -m rust_backend/Cargo.toml --strip && \
    maturin build --release -m fintally_finance/Cargo.toml --strip && \
    maturin build --release -m fintally_chatbot/Cargo.toml --strip

# ====================== RUNTIME STAGE ======================
FROM python:3.10-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    cmake \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Copy wheels from builder
COPY --from=builder /app/fintally_core/target/wheels/*.whl /wheels/

# Install dependencies
COPY requirements.txt ./

RUN pip install --no-cache-dir -r requirements.txt && \
    if [ "$LLAMA_NO_AVX" = "1" ]; then \
        export CMAKE_ARGS="-DGGML_AVX=OFF \
                            -DGGML_AVX2=OFF \
                            -DGGML_AVX512=OFF \
                            -DGGML_FMA=OFF \
                            -DGGML_F16C=OFF \
                            -DGGML_NATIVE=OFF"; \
    else \
        export CMAKE_ARGS="-DGGML_AVX=ON \
                            -DGGML_AVX2=ON \
                            -DGGML_AVX512=OFF \
                            -DGGML_FMA=ON \
                            -DGGML_F16C=ON \
                            -DGGML_NATIVE=ON"; \
    fi && \
    export FORCE_CMAKE=1 && \
    pip install --no-cache-dir llama-cpp-python && \
    pip install --no-cache-dir /wheels/*.whl

# Copy app source
COPY . .

# Security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]