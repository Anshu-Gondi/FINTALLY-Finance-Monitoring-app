# --- LLaMA (CPU build — SSE4.2 ONLY, NO AVX) ---
# IMPORTANT: Do NOT install from the pre-built wheel index below.
# Those wheels are compiled for AVX2. Your Celeron N4020 only has SSE4.2.
# Running an AVX2 binary on SSE4.2 = illegal instruction crash.
#
# Instead, compile from source ONCE using:
#
#   Windows (cmd, not PowerShell):
#     set CMAKE_ARGS=-DGGML_AVX=OFF -DGGML_AVX2=OFF -DGGML_AVX512=OFF -DGGML_FMA=OFF -DGGML_F16C=OFF -DGGML_NATIVE=OFF
#     set FORCE_CMAKE=1
#     pip install llama-cpp-python --no-cache-dir
#
# After that one manual install, this line just tracks the dependency:
# llama-cpp-python
numpy==1.26.4        # pin: llama_cpp_python wheel requires <2.0

# --- Build (needed at image build time, not runtime) ---
maturin

# --- Test ---
pytest
pytest-asyncio
pytest-timeout