# ====================================================================
# FinTally Monorepo Root Git Ignore Configuration
# ====================================================================

# ─── Security, Secret Keys & Cloud OAuth Tokens ───────────────────
**/.env
**/.env.*
*.key
*.pem
.secret/
secrets/
# Protects active Google Drive OAuth token caches
chatbot-backend/mycreds.txt
# Protects core client API developer keys
chatbot-backend/client_secret.json

# ─── FinTally AI Vector Engines & Local Doc Pipelines ──────────────
# Excludes physical Rust HNSW database indices
chatbot-backend/vector_storage/
# Excludes active tax/policy document caches
chatbot-backend/trusted_docs_source/
# Cleans up temporary plain-text parser mirrors
**/*.pdf.txt

# ─── Large LLM Model Assets ─────────────────────────────────────────
chatbot-backend/llm_models/          # Cuts out deep GGUF models (tinyllama, phi-2)
*.gguf
*.bin
*.pth
*.safetensors

# ─── Rust Workspace Crates & Native Compilations ──────────────────
# Strips all heavy Cargo compile artifacts
**/target/
chatbot-backend/fintally_core/target/
chatbot-backend/fintally_core/nextest_full.log
chatbot-backend/fintally_core/build_errors.log

# ─── Python Virtual Environments & Interpreter Caches ───────────────
chatbot-backend/venv/
**/__pycache__/
**/*.py[cod]
**/*.pyd
.mypy_cache/
.pytest_cache/

# ─── Database Layouts & File Upload Temp Caches ─────────────────────
chatbot-backend/uploads/
!chatbot-backend/uploads/favicon.ico # White-lists app icon graphic asset
*.sqlite3
*.db
*.sql
*.tmp
*.bak

# ─── Frontend React & Node Ecosystems ───────────────────────────────
frontend/node_modules/
**/node_modules/
frontend/dist/
frontend/.vite/
**/*.log
**/*.log*
package-lock.json
pnpm-lock.yaml

# ─── IDE Configurations & Operating System Garbage ──────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ─── System Archives & Compression Blocks ────────────────────────────
*.zip
*.gz
*.tar
*.rar
*.7z
.cache/
temp/

# Ignore sensitive keys and tokens
fintally_core/.secure_vault/
fintally_core/client_secret.json

# Ignore local document sources
fintally_core/trusted_docs_source/
fintally_core/client_secret.json
