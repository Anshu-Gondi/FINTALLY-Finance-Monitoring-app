# -------------------------------------------------------------
# Stage 1: The Planner (Runs at Root Context)
# -------------------------------------------------------------
FROM lukemathwalker/cargo-chef:latest-rust-1.80-slim-bookworm AS planner
WORKDIR /app
COPY . .
# 🧠 Run from root so cargo-chef can map all workspace members flawlessly
RUN cargo chef prepare --recipe-path recipe.json

# -------------------------------------------------------------
# Stage 2: The Cacher (Builds Workspace Dependencies)
# -------------------------------------------------------------
FROM lukemathwalker/cargo-chef:latest-rust-1.80-slim-bookworm AS cacher
WORKDIR /app

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy the recipe file generated at the root level
COPY --from=planner /app/recipe.json recipe.json

# 🧠 Cook from root, telling it explicitly which target crates to prepare caching for
RUN cargo chef cook --release --recipe-path recipe.json

# -------------------------------------------------------------
# Stage 3: The Source Builder
# -------------------------------------------------------------
FROM rust:1.80-slim-bookworm AS builder
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Bring in the pre-compiled dependencies into the target cache
COPY --from=cacher /app/target target
COPY --from=cacher /usr/local/cargo /usr/local/cargo

# 2. Copy your actual project source files
COPY . .

# Move back down into your core directory to run binaries/compilation
WORKDIR /app/fintally_core

# Tell SQLx to look at the .sqlx directory copied from the root
ENV SQLX_OFFLINE=true

# 3. Compile and execute the model downloader
RUN cargo build --release -p fintally_chatbot --bin download_models
RUN ./target/release/download_models

# 4. Compile the primary Axum application entry point
RUN cargo build --release -p fintally_axum --bin fintally_axum

# -------------------------------------------------------------
# Stage 4: The Hardened Black Box (Runtime)
# -------------------------------------------------------------
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Extract artifacts using your correct structural mapping paths
COPY --from=builder /app/fintally_core/target/release/fintally_axum /app/fintally_backend
COPY --from=builder /app/fintally_core/llm_models /app/llm_models

EXPOSE 8080
CMD ["./fintally_backend"]