# ==============================================================================
# --- Stage 1: Base Environment (Toolchain & cargo-chef) ---
# ==============================================================================
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04 AS chef-base

ARG CUDA_COMPUTE_CAP=89
ENV CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP}
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:ubuntu-toolchain-r/test \
    && apt-get update && apt-get install -y \
    pkg-config libssl-dev cmake g++-12 gcc-12 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV CC=/usr/bin/gcc-12
ENV CXX=/usr/bin/g++-12

# Install Rust & Cargo Chef
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:/usr/local/cuda/bin:${PATH}"
ENV CUDA_PATH="/usr/local/cuda"

# Install cargo-chef
RUN cargo install cargo-chef --locked


# ==============================================================================
# --- Stage 2: Planner (Analyzes dependencies) ---
# ==============================================================================
FROM chef-base AS planner

WORKDIR /app
COPY . .
WORKDIR /app/fintally_core

# Generate a recipe.json containing ONLY your dependencies
RUN cargo chef prepare --recipe-path recipe.json


# ==============================================================================
# --- Stage 3: Builder (Cooks dependencies & builds app) ---
# ==============================================================================
FROM chef-base AS builder

WORKDIR /app/fintally_core

# 1. Copy ONLY the recipe.json from the planner stage
COPY --from=planner /app/fintally_core/recipe.json recipe.json

# 2. Build dependencies - THIS LAYER GETS CACHED!
RUN cargo chef cook --release --recipe-path recipe.json

# 3. NOW copy your actual source code.
# (If you change your code, Docker starts from here, keeping dependencies cached!)
WORKDIR /app
COPY . .
WORKDIR /app/fintally_core

ENV SQLX_OFFLINE=true

# 4. Compile and run the model downloader
RUN cargo build --release -p fintally_chatbot --bin download_models
RUN ./target/release/download_models

# 5. Compile the primary Axum application
RUN cargo build --release -p fintally_axum --bin fintally_axum


# ==============================================================================
# --- Stage 4: The Hardened Black Box (Runtime) ---
# ==============================================================================
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Extract the compiled binary and downloaded models using the updated paths
COPY --from=builder /app/fintally_core/target/release/fintally_axum /app/fintally_backend
COPY --from=builder /app/fintally_core/llm_models /app/llm_models

EXPOSE 8080
CMD ["./fintally_backend"]
