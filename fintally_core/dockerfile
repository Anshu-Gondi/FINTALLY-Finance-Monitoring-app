# syntax=docker/dockerfile:1
# ==============================================================================
# --- Stage 1: Base Environment ---
# ==============================================================================
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04 AS chef-base

ARG CUDA_COMPUTE_CAP=89
ENV CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP}
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:ubuntu-toolchain-r/test \
    && apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev cmake g++-12 gcc-12 curl ca-certificates \
    clang libclang-dev \
    && apt-get purge -y cuda-nsight* cuda-documentation* cuda-visual-tools* cuda-demo-suite* \
    && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

ENV CC=/usr/bin/gcc-12
ENV CXX=/usr/bin/g++-12
ENV LIBCLANG_PATH="/usr/lib/llvm-14/lib"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:/usr/local/cuda/bin:${PATH}"
ENV CUDA_PATH="/usr/local/cuda"

RUN cargo install cargo-chef --locked

# ==============================================================================
# --- Stage 2: Planner ---
# ==============================================================================
FROM chef-base AS planner
WORKDIR /app
COPY . .
WORKDIR /app/fintally_core
RUN cargo chef prepare --recipe-path recipe.json

# ==============================================================================
# --- Stage 3: Builder ---
# ==============================================================================
FROM chef-base AS builder
WORKDIR /app/fintally_core

COPY --from=planner /app/fintally_core/recipe.json recipe.json

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/app/fintally_core/target \
    cargo chef cook --release --recipe-path recipe.json

WORKDIR /app
COPY . .
WORKDIR /app/fintally_core

ENV SQLX_OFFLINE=true

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/app/fintally_core/target \
    cargo build --release -p fintally_chatbot --bin download_models && \
    cargo build --release -p fintally_axum --bin fintally_axum && \
    mkdir -p /app/bin && \
    cp /app/fintally_core/target/release/download_models /app/bin/ && \
    cp /app/fintally_core/target/release/fintally_axum /app/bin/

# ==============================================================================
# --- Stage 4: Model Downloader Stage (Fixed Paths) ---
# ==============================================================================
FROM chef-base AS model-fetcher
# Create and work inside fintally_core directory so outputs land in /app/fintally_core/llm_models
WORKDIR /app/fintally_core
COPY --from=builder /app/bin/download_models /app/fintally_core/download_models
RUN /app/fintally_core/download_models

# ==============================================================================
# --- Stage 5: Hardened Runtime ---
# ==============================================================================
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/bin/fintally_axum /app/fintally_backend
COPY --from=model-fetcher /app/fintally_core/llm_models /app/llm_models

EXPOSE 8080
CMD ["./fintally_backend"]
