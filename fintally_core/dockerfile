# --- Stage 1: The Automated Factory (Builder) ---
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04 AS builder

# Define a build argument for the GPU compute capability (default to 89 for RTX 40-series / L4)
ARG CUDA_COMPUTE_CAP=89
ENV CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP}

# Prevent interactive prompts during apt-get installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies, software-properties-common, and modern GCC 12/G++ 12
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:ubuntu-toolchain-r/test \
    && apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    g++-12 \
    gcc-12 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Force the compiler to use GCC 12 to support advanced instruction sets (e.g., AVX512/AMX in numkong)
ENV CC=/usr/bin/gcc-12
ENV CXX=/usr/bin/g++-12

# Install Rust toolchain manually on top of the CUDA devel image
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:/usr/local/cuda/bin:${PATH}"
ENV CUDA_PATH="/usr/local/cuda"

WORKDIR /app

# Copies the entire project folder context into the builder
COPY . .

# Move directly into your workspace subdirectory before compiling
WORKDIR /app/fintally_core

# 🧠 CRITICAL FIX: Tell SQLx to use the .sqlx cache *during* compilation!
ENV SQLX_OFFLINE=true

# 1. Compile and execute the downloader tool from the chatbot crate with CUDA features enabled
RUN cargo build --release -p fintally_chatbot --bin download_models
RUN ./target/release/download_models

# 2. Compile your primary running Axum entry point with CUDA features enabled
RUN cargo build --release -p fintally_axum --bin fintally_axum

# --- Stage 2: The Hardened Black Box (Runtime) ---
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Extract the compiled binary and downloaded models using the updated paths
COPY --from=builder /app/fintally_core/target/release/fintally_axum /app/fintally_backend
COPY --from=builder /app/fintally_core/llm_models /app/llm_models

EXPOSE 8080
CMD ["./fintally_backend"]
