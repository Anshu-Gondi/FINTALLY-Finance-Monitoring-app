# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Connection string for Supabase PostgreSQL (replace placeholders with your actual credentials)
DATABASE_URL="postgresql://postgres.yourclouddb:your_password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ==========================================
# SUPABASE API CREDENTIALS
# ==========================================
# Found in your Supabase Project Settings > API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"
SUPABASE_SECRET_KEY="your_supabase_secret_key_here"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/rest/v1/jwks"

# ==========================================
# AUTHENTICATION & JWT
# ==========================================
# Secret used to sign and verify JSON Web Tokens (found in Supabase JWT Settings)
JWT_SECRET="your_jwt_secret_here"

# ==========================================
# GOOGLE OAUTH CREDENTIALS
# ==========================================
# Obtained from the Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
