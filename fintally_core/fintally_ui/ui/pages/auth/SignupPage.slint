import { Button, CheckBox, LineEdit } from "std-widgets.slint";

// Signup is email/password only. The current IPC contract has no display-name
// field, so the UI must not imply that a name is persisted.
export component SignupPage inherits Rectangle {
    background: #070b16;

    in-out property <string> email-input: "";
    in-out property <string> password-input: "";
    in-out property <string> confirm-password-input: "";
    in-out property <string> status-text: "Create your FinTally account.";
    in-out property <bool> busy: false;
    in-out property <bool> local-only-mode: true;

    callback signup-requested(string, string, string, bool);
    callback login-navigation-requested();
    callback google-navigation-requested();

    VerticalLayout {
        padding: root.width < 480px ? 16px : 28px;
        spacing: 16px;
        alignment: center;

        Rectangle {
            width: root.width < 540px ? root.width - 32px : 460px;
            background: #101a2c;
            border-radius: 24px;
            border-width: 1px;
            border-color: #25445a;

            VerticalLayout {
                padding: root.width < 480px ? 20px : 30px;
                spacing: 14px;

                Rectangle {
                    width: 64px;
                    height: 4px;
                    background: #a78bfa;
                    border-radius: 2px;
                }
                Text {
                    text: "FINTALLY  /  GET STARTED";
                    color: #a78bfa;
                    font-size: 11px;
                    font-weight: 700;
                }
                Text {
                    text: "Create your account";
                    color: #eef6ff;
                    font-size: 28px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: "Create credentials first. After the account is created, FinTally returns you to sign-in.";
                    color: #a5b5cd;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                LineEdit {
                    width: 100%;
                    height: 44px;
                    text <=> root.email-input;
                    placeholder-text: "Email address";
                    enabled: !root.busy;
                    accessible-label: "Email address";
                }
                LineEdit {
                    width: 100%;
                    height: 44px;
                    text <=> root.password-input;
                    placeholder-text: "Password (8–72 UTF-8 bytes)";
                    input-type: password;
                    enabled: !root.busy;
                    accessible-label: "Password";
                }
                LineEdit {
                    width: 100%;
                    height: 44px;
                    text <=> root.confirm-password-input;
                    placeholder-text: "Confirm password";
                    input-type: password;
                    enabled: !root.busy;
                    accessible-label: "Confirm password";
                }

                CheckBox {
                    width: 100%;
                    text: "Keep finance data on this device only";
                    checked <=> root.local-only-mode;
                    enabled: !root.busy;
                }
                Text {
                    text: root.local-only-mode
                        ? "LOCAL ONLY · credentials use this device's SQLite store."
                        : "CLOUD SYNC · explicitly selected; a cloud connection is required.";
                    color: root.local-only-mode ? #4be6c0 : #ffcf70;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Button {
                    width: 100%;
                    text: root.busy ? "Creating account…" : "Create account";
                    primary: true;
                    enabled: !root.busy;
                    clicked => {
                        root.signup-requested(
                            root.email-input,
                            root.password-input,
                            root.confirm-password-input,
                            root.local-only-mode
                        );
                        root.password-input = "";
                        root.confirm-password-input = "";
                    }
                }
                Button {
                    width: 100%;
                    text: "Already have an account? Sign in";
                    enabled: !root.busy;
                    clicked => { root.login-navigation-requested(); }
                }

                Text {
                    text: root.status-text;
                    color: #d7e4f7;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Account creation does not require Google. Local-only and cloud-sync accounts are separate storage scopes.";
                    color: #8295b2;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
